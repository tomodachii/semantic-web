@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix kg: <https://example.org/ontology/> .

<https://example.org/ontology/movie-knowledge-graph>
    a owl:Ontology ;
    rdfs:label "Movie Knowledge Graph Ontology"@en ;
    rdfs:comment "An OWL ontology for the movie RDF dataset generated from TMDB data. It defines a local movie vocabulary in the kg namespace."@en ;
    owl:versionInfo "2.0.0" .

#################################################################
# Classes
#################################################################

kg:Movie
    a owl:Class ;
    rdfs:label "Movie"@en ;
    rdfs:comment "A motion picture represented in the movie knowledge graph."@en ;
    owl:disjointWith kg:Person, kg:Genre, kg:Country,
        kg:Language, kg:Role .

kg:Person
    a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "An actor or director represented by a shared TMDB person identity."@en .

kg:Role
    a owl:Class ;
    rdfs:label "Acting role"@en ;
    rdfs:comment "A reified acting role connecting a movie, an actor, a character name, and cast position."@en ;
    owl:disjointWith kg:Movie, kg:Person, kg:Genre,
        kg:Country, kg:Language .

kg:Genre
    a owl:Class ;
    rdfs:label "Genre"@en ;
    rdfs:comment "A genre assigned to a movie."@en ;
    owl:disjointWith kg:Person, kg:Country, kg:Language .

kg:Country
    a owl:Class ;
    rdfs:label "Country"@en ;
    rdfs:comment "A recorded production country of a movie; not necessarily a filming location."@en ;
    owl:disjointWith kg:Person, kg:Language,
        kg:Role .

kg:Language
    a owl:Class ;
    rdfs:label "Language"@en ;
    rdfs:comment "A language associated with a movie."@en ;
    owl:disjointWith kg:Person, kg:Country,
        kg:Role .

kg:Keyword
    a owl:Class ;
    rdfs:label "Keyword"@en ;
    rdfs:comment "A TMDB keyword represented as a shared term with a name."@en ;
    owl:disjointWith kg:Movie, kg:Person, kg:Role,
        kg:Genre, kg:Country, kg:Language .

#################################################################
# Object properties
#################################################################

kg:actor
    a owl:ObjectProperty ;
    rdfs:label "actor"@en ;
    rdfs:comment "Links a movie to an actor or reified role, and links a reified role to its actor."@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( kg:Movie kg:Role )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf ( kg:Person kg:Role )
    ] .

kg:countryOfOrigin
    a owl:ObjectProperty ;
    rdfs:label "country of origin"@en ;
    rdfs:domain kg:Movie ;
    rdfs:range kg:Country .

kg:director
    a owl:ObjectProperty ;
    rdfs:label "director"@en ;
    rdfs:domain kg:Movie ;
    rdfs:range kg:Person .

kg:genre
    a owl:ObjectProperty ;
    rdfs:label "genre"@en ;
    rdfs:domain kg:Movie ;
    rdfs:range kg:Genre .

kg:keywords
    a owl:ObjectProperty ;
    rdfs:label "keywords"@en ;
    rdfs:comment "Links a movie to a keyword resource identified by its TMDB keyword ID."@en ;
    rdfs:domain kg:Movie ;
    rdfs:range kg:Keyword .

kg:inLanguage
    a owl:ObjectProperty ;
    rdfs:label "in language"@en ;
    rdfs:comment "Combines original and spoken languages, following the reference mapping."@en ;
    rdfs:domain kg:Movie ;
    rdfs:range kg:Language .

kg:directedMovie
    a owl:ObjectProperty ;
    rdfs:label "directed movie"@en ;
    rdfs:domain kg:Person ;
    rdfs:range kg:Movie ;
    owl:inverseOf kg:director .

# The actor predicate targets both people and role nodes. Therefore this
# shortcut also has a union range: a Person-only range would wrongly type
# acting-role nodes as people. Queries for actors should require kg:Person.
kg:hasCastMember
    a owl:ObjectProperty ;
    rdfs:label "has cast member"@en ;
    rdfs:comment "Links a director to people or acting roles in movies they directed. Filter for Person when listing actors."@en ;
    rdfs:domain kg:Person ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf ( kg:Person kg:Role )
    ] ;
    owl:propertyChainAxiom ( kg:directedMovie kg:actor ) .

#################################################################
# Datatype properties
#################################################################

kg:abstract
    a owl:DatatypeProperty ;
    rdfs:label "abstract"@en ;
    rdfs:domain kg:Movie ;
    rdfs:range xsd:string .

kg:characterName
    a owl:DatatypeProperty ;
    rdfs:label "character name"@en ;
    rdfs:domain kg:Role ;
    rdfs:range xsd:string .

kg:datePublished
    a owl:DatatypeProperty ;
    rdfs:label "date published"@en ;
    rdfs:domain kg:Movie ;
    rdfs:range xsd:date .

kg:duration
    a owl:DatatypeProperty ;
    rdfs:label "duration"@en ;
    rdfs:domain kg:Movie ;
    rdfs:range xsd:duration .

kg:name
    a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( kg:Movie kg:Person kg:Genre
            kg:Country kg:Language kg:Keyword )
    ] ;
    rdfs:range xsd:string .

kg:position
    a owl:DatatypeProperty ;
    rdfs:label "cast position"@en ;
    rdfs:domain kg:Role ;
    rdfs:range xsd:integer .

kg:ratingValue
    a owl:DatatypeProperty ;
    rdfs:label "rating value"@en ;
    rdfs:domain kg:Movie ;
    rdfs:range xsd:decimal .

kg:referencePage
    a owl:ObjectProperty ;
    rdfs:label "reference page"@en ;
    rdfs:domain kg:Movie ;
    rdfs:range rdfs:Resource .

#################################################################
# OWL restrictions
# rdfs:subClassOf below attaches restrictions, not broad superclass categories.
# Under open-world semantics these are not missing-field validation checks.
#################################################################

kg:Movie
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty kg:name ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger
        ],
        [ a owl:Restriction ;
          owl:onProperty kg:ratingValue ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger
        ] .

kg:Role
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty kg:actor ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass kg:Person
        ],
        [ a owl:Restriction ;
          owl:onProperty kg:characterName ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger
        ],
        [ a owl:Restriction ;
          owl:onProperty kg:position ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger
        ] .

#################################################################
# T-Box
#################################################################
@prefix kg: <https://example.org/ontology/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/movie/100402> a kg:Movie ;
    kg:abstract "After the cataclysmic events in New York with The Avengers, Steve Rogers, aka Captain America is living quietly in Washington, D.C. and trying to adjust to the modern world. But when a S.H.I.E.L.D. colleague comes under attack, Steve becomes embroiled in a web of intrigue that threatens to put the world at risk. Joining forces with the Black Widow, Captain America struggles to expose the ever-widening conspiracy while fighting off professional assassins sent to silence him at every turn. When the full scope of the villainous plot is revealed, Captain America and the Black Widow enlist the help of a new ally, the Falcon. However, they soon find themselves up against an unexpected and formidable enemy—the Winter Soldier." ;
