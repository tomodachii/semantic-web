# Q8: What are the recorded production countries of each movie?
# Uses movie_countries.csv directly; these are not necessarily filming locations.
PREFIX schema: <https://schema.org/>
SELECT DISTINCT ?movie ?title ?country ?countryName WHERE {
  ?movie a schema:Movie ; schema:name ?title ; schema:countryOfOrigin ?country .
  OPTIONAL { ?country schema:name ?countryName }
}
ORDER BY ?title ?countryName
