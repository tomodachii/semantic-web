# Q4: Which Drama films rank highest with at least 100 votes?
# 100 is a chosen evidence threshold, not a universal definition of a reliable rating.
PREFIX schema: <https://schema.org/>
SELECT ?movie ?title ?average ?votes WHERE {
  ?movie a schema:Movie ; schema:name ?title ; schema:genre ?genre ;
         schema:aggregateRating ?rating .
  ?genre schema:name "Drama" .
  ?rating schema:ratingValue ?average ; schema:ratingCount ?votes .
  FILTER (?votes >= 100)
}
ORDER BY DESC(?average) DESC(?votes) ?title
LIMIT 20
