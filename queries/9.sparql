# Q9: Which films have more than one recorded language?
# Includes both original and spoken languages, matching kg:inLanguage.
PREFIX kg: <https://example.org/ontology/>
SELECT ?movie ?title (COUNT(DISTINCT ?language) AS ?languages) WHERE {
  ?movie a kg:Movie ; kg:name ?title ; kg:inLanguage ?language .
}
GROUP BY ?movie ?title
HAVING (COUNT(DISTINCT ?language) > 1)
ORDER BY DESC(?languages) ?title
