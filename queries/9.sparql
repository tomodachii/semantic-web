# Q9: Which films have more than one recorded spoken language?
# Contract: schema:inLanguage must come from spoken-language rows only.
# Original language is a separate property in our proposed mapping.
PREFIX schema: <https://schema.org/>
SELECT ?movie ?title (COUNT(DISTINCT ?language) AS ?languages) WHERE {
  ?movie a schema:Movie ; schema:name ?title ; schema:inLanguage ?language .
}
GROUP BY ?movie ?title
HAVING (COUNT(DISTINCT ?language) > 1)
ORDER BY DESC(?languages) ?title
