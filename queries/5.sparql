# Q5: Which films since 2010 feature a selected actor in a selected genre?
# Replace the actor ID and genre label using actual notebook values.
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?movie ?title ?date WHERE {
  VALUES ?actor { <https://example.org/person/1245> }
  VALUES ?genreName { "Action" }
  ?movie a schema:Movie ; schema:name ?title ; schema:datePublished ?date ;
         schema:actor ?actor ; schema:genre ?genre .
  ?actor a schema:Person .
  ?genre schema:name ?genreName .
  FILTER (?date >= "2010-01-01"^^xsd:date)
}
ORDER BY ?date ?title
